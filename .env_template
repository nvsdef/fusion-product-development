# Copy to .env and adjust. All optional -- setup.sh has working defaults.

# Where the fusion-mcp-server repo lives on the host
FUSION_MCP_REPO=C:/Users/<you>/Documents/fusion-mcp-server

# Optional: the interpreter that runs the stdio server. Derived from
# FUSION_MCP_REPO by scripts/setup/env-loader.sh -- .venv/Scripts/python.exe on
# Windows, .venv/bin/python elsewhere. Set it only for a non-venv interpreter.
# FUSION_MCP_PYTHON=

# Fusion add-in install target (Windows)
FUSION_ADDINS_DIR=%APPDATA%/Autodesk/Autodesk Fusion 360/API/AddIns

# Add-in socket. Must match event_bridge/socket_server.
FUSION_MCP_PORT=9876

# Both timeouts, seconds. create_drawing measured 47.2 s and fails at 30.
FUSION_MCP_TIMEOUT=300

# Where renders and drawings are written
FUSION_OUTPUT_DIR=C:/Users/<you>/Documents/fusion-renders

# Optional: pin a non-NVIDIA inference endpoint
# INFERENCE_API_KEY=
